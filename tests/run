#!/usr/bin/env bash
# Test suite for omarchy-workspace-rename

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEST_DIR=$(mktemp -d)
export STATE_FILE="$TEST_DIR/workspace-names.json"
trap 'rm -rf "$TEST_DIR"' EXIT

echo "Running tests for omarchy-workspace-rename..."

# Test: Basic rename
test_basic_rename() {
    echo -n "  Testing basic rename... "
    ./omarchy-workspace-rename 1 dev >/dev/null 2>&1
    if grep -q '"1": "dev"' "$STATE_FILE" 2>/dev/null; then
        echo "✓"
        return 0
    else
        echo "✗ Failed"
        return 1
    fi
}

# Test: List workspaces
test_list() {
    echo -n "  Testing list command... "
    output=$(./omarchy-workspace-rename --list 2>/dev/null)
    if echo "$output" | grep -q "Workspace 1: dev"; then
        echo "✓"
        return 0
    else
        echo "✗ Failed"
        return 1
    fi
}

# Test: Reset workspace
test_reset() {
    echo -n "  Testing reset command... "
    ./omarchy-workspace-rename --reset 1 >/dev/null 2>&1
    if ! grep -q '"1"' "$STATE_FILE" 2>/dev/null; then
        echo "✓"
        return 0
    else
        echo "✗ Failed"
        return 1
    fi
}

# Test: Invalid workspace ID
test_invalid_id() {
    echo -n "  Testing invalid workspace ID... "
    if ./omarchy-workspace-rename 0 test 2>/dev/null; then
        echo "✗ Should have failed"
        return 1
    else
        echo "✓"
        return 0
    fi
}

# Test: Name with spaces
test_name_with_spaces() {
    echo -n "  Testing name with spaces... "
    if ./omarchy-workspace-rename 1 "test name" 2>/dev/null; then
        echo "✗ Should have failed"
        return 1
    else
        echo "✓"
        return 0
    fi
}

# Test: Name with injection attempt
test_name_with_injection() {
    echo -n "  Testing name with injection attempt... "
    if ./omarchy-workspace-rename 1 'test" .. os.execute("echo pwned") .. "' 2>/dev/null; then
        echo "✗ Should have failed"
        return 1
    else
        echo "✓"
        return 0
    fi
}

# Run all tests
main() {
    cd "$SCRIPT_DIR/.."
    
    
    local failed=0
    
    test_basic_rename || failed=$((failed + 1))
    test_list || failed=$((failed + 1))
    test_reset || failed=$((failed + 1))
    test_invalid_id || failed=$((failed + 1))
    test_name_with_spaces || failed=$((failed + 1))
    test_name_with_injection || failed=$((failed + 1))
    
    
    echo ""
    if [[ $failed -eq 0 ]]; then
        echo "All tests passed ✓"
        return 0
    else
        echo "$failed test(s) failed ✗"
        return 1
    fi
}

main
